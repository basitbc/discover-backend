# Discover Kashmir — content & payments API
#
# Copy to .env for local development. In production set these in your host's
# environment settings, never in a file.
#
# Everything not listed under "Required" has a working default. The server
# validates this on boot and exits with a readable list if anything is missing
# or malformed, rather than failing later in a confusing way.

# ── Required ──────────────────────────────────────────────────────────────────

# Neon: use the POOLED connection string (its host contains "-pooler").
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require"

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Public URL of THIS api. Used to build the payment gateway's return URL, so a
# wrong value means payments complete and the confirmation lands nowhere.
PUBLIC_BASE_URL="https://api.thediscoverkashmir.in"

# Public URL of the WEBSITE. Also the default CORS origin, and where customers
# are sent after paying.
SITE_BASE_URL="https://thediscoverkashmir.in"

# Must match REVALIDATE_SECRET in the website's environment. This is what makes
# an admin save appear on the live site within seconds.
REVALIDATE_SECRET=""

# ── Images ────────────────────────────────────────────────────────────────────
# "local" stores on this server's disk (fine for development; needs a
# persistent volume in production). "cloudinary" delivers via CDN with
# automatic format and quality optimisation — recommended.
STORAGE_DRIVER="cloudinary"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Payments ──────────────────────────────────────────────────────────────────
# "live" uses secure.ccavenue.com, "test" uses test.ccavenue.com. They have
# SEPARATE credentials — a live key will not work against test.
# Leave the three blank to keep payments switched off; the admin then shows a
# banner naming exactly what is missing instead of failing at checkout.
CCAVENUE_ENV="live"
CCAVENUE_MERCHANT_ID=""
CCAVENUE_ACCESS_CODE=""
CCAVENUE_WORKING_KEY=""

# ── Optional (sensible defaults; set only if you need to change them) ─────────
# DIRECT_URL          Neon's non-pooled string. Only needed if migrations run
#                     from the deployed service rather than your machine.
# CORS_ORIGINS        Comma-separated extra origins. Defaults to SITE_BASE_URL.
#                     Any localhost port is allowed automatically in development.
# PORT                Injected by most hosts. Defaults to 4000.
# LOG_LEVEL           Defaults to "info".
# IMAGE_MAX_WIDTH     Longest delivered edge in px. Defaults to 1920.
# MAX_UPLOAD_BYTES    Defaults to 8 MB.
# JWT_EXPIRES_IN      Admin session length. Defaults to "12h".
# CLOUDINARY_FOLDER   Defaults to "discover-kashmir".
# UPLOAD_DIR          Only used by STORAGE_DRIVER=local. Defaults to "uploads".
# SEED_ADMIN_EMAIL    Used only by `npm run seed`, never at runtime.
# SEED_ADMIN_PASSWORD
